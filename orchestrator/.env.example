# Database and Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_long_random_local_password
DB_HOST=localhost
DB_PORT=5432
DB_USER=doblador
DB_PASSWORD=replace_with_a_long_random_local_password
DB_NAME=doblador_db

# Google Gemini API Key (script translation and adaptation for dubbing)
GEMINI_API_KEY=your_gemini_api_key_here

# Fish Audio API Keys (supports up to 3 keys for 3x parallel synthesis and automatic failover)
FISH_AUDIO_API_KEY=your_first_fish_api_key_here
FISH_AUDIO_API_KEY_2=your_second_optional_fish_api_key_here
FISH_AUDIO_API_KEY_3=your_third_optional_fish_api_key_here

# Python Microservice URL (STT, Demucs stem separation, Diarization, DSP Stitching)
PYTHON_SERVICES_URL=http://127.0.0.1:8000

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload file size in megabytes
MAX_UPLOAD_MB=2048

# Listening interface (defaults to loopback for security since the API has no public auth)
# API_BIND_HOST=127.0.0.1
# PY_BIND_HOST=127.0.0.1

# Fish Audio Voice Pools by Demographic Profile (comma-separated IDs rotated per speaker)
# Young Male (<45 years old)
FISH_VOICE_POOL_MALE_YOUNG=7033e0e6d35e404d81a100701ceca41b,dfa5b230c8054f429e434f4a6e9bbdec,35199d5438854f5d9157c500479ab684

# Mature Male (>=45 years old)
FISH_VOICE_POOL_MALE_MATURE=7033e0e6d35e404d81a100701ceca41b,8d2c17a9b26d4d83888ea67a1ee565b2,bcdc2d4b044d4a6992d9260ce16715eb

# Young Female (<45 years old)
FISH_VOICE_POOL_FEMALE_YOUNG=8d75acf7b75b470ba5d975191bebf5f3,35929683c49c4ec0bf779dc07d22620b,bfed5c0810a347dbb62e8ccce7f59c48

# Mature Female (>=45 years old)
FISH_VOICE_POOL_FEMALE_MATURE=26ff45fab722431c85eea2536e5c5197,692eb1e1023242219dc8caae8c56fb12

